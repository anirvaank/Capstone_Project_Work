    const line = USER_ID != null ? `${TAG} ${msg} userId=${USER_ID}` : `${TAG} ${msg}`;
    try { LOG_ON_SERVER && LOG_ON_SERVER(line); } catch(_) {}
    console.log(line);
  };

  // Convert column-major state[x][y] -> row-major rows[r][c] using actual dims
  function colsToRowsDyn(state){
    if (!state) return null;
    const W = state.length;
    const H = W ? (state[0]?.length ?? 0) : 0;
    const rows = Array.from({length:H}, (_, r) =>
      Array.from({length:W}, (_, c) => {
        const v = norm(state[c]?.[r]);
        return v === EMPTY ? "" : v;
      })
